# Cấu hình dịch vụ VPS WordPress Control
# Tuân thủ quy ước: Port nằm trong dải 9000 - 9999

APP_NAME="VPS WordPress Control"
APP_ENV=development
APP_PORT=9090
APP_HOST=0.0.0.0

# Bảo mật & Xác thực Panel
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin_password_change_me

# Đường dẫn dữ liệu nội bộ
DATA_DIR=./data
DB_NAME=wpcontrol.db

# Đường dẫn hệ thống trên VPS (khi chạy production trực tiếp trên host)
NGINX_SITES_DIR=/etc/nginx/sites-enabled
NGINX_TEMPLATES_DIR=./templates
WWW_ROOT_DIR=/var/www
LOG_DIR=./logs

